# WeatherGPT Environment Variables
# Copy this file to .env and fill in your values
#
# This file documents every env var referenced via os.getenv / os.environ
# across all Python modules in this repository.

# === Database: PostgreSQL + PostGIS ==========================================
POSTGRES_URL=postgresql+asyncpg://weathergpt:weathergpt_dev_password@localhost:5432/weathergpt
POSTGRES_PASSWORD=weathergpt_dev_password

# === Database: MongoDB ========================================================
MONGO_URL=mongodb://weathergpt:weathergpt_dev_password@localhost:27017/weathergpt?authSource=admin
MONGO_PASSWORD=weathergpt_dev_password

# === Database: TimescaleDB ===================================================
TIMESCALE_URL=postgresql+asyncpg://weathergpt:weathergpt_dev_password@localhost:5433/weathergpt_ts
TIMESCALE_PASSWORD=weathergpt_dev_password

# === JWT Authentication ======================================================
JWT_SECRET=weathergpt-dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# === Google Gemini / LLM =====================================================
# AI_engine.py and weathergpt_expert.py accept any of these three keys
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-key-here
GEMINI_MODEL=gemini-2.0-flash

# Expert LLM tuning (weathergpt_expert.py)
EXPERT_MAX_TOKENS=2048
EXPERT_TEMPERATURE=0.4

# === WhatsApp (Meta Cloud API) ================================================
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
AGENT_NOTIFY_WEBHOOK_URL=https://your-internal-webhook.example.com/notify

# === WhatsApp (Twilio) ========================================================
# Used by Whatsapp_bot.py — optional if you prefer Twilio's WhatsApp API
# over Meta's Cloud API. Uses the same Twilio creds as SMS/Voice below.

# === Twilio — SMS / Voice / WhatsApp =========================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_NUMBER=+1234567890          # your Twilio phone number (E.164 format)
TWILIO_SMS_NUMBER=+1234567890      # defaults to TWILIO_NUMBER if not set
TWILIO_WHATSAPP_NUMBER=+14155238803  # your Twilio WhatsApp sandbox/production number

# === Voice / Speech ===========================================================
# Used by voice_webhook.py for warm-transfer outbound calls
PUBLIC_BASE_URL=http://localhost:8000

# Whisper model size for voice_service.py STT
WHISPER_MODEL_SIZE=base

# Bhashini API (Indian language STT/TTS) — voice_service.py
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-api-key

# === Weather APIs =============================================================
# StormGlass marine/coastal data (weather_service.py)
STORMGLASS_API_KEY=your-stormglass-api-key

# CBAS / VHF / CSC (stubs — not yet funded)
# Cell Broadcast and VHF/CSC channels have stub dispatchers in alert_dispatcher.py
CBAS_API_KEY=
CBAS_API_URL=
VHF_CSC_API_KEY=
VHF_CSC_API_URL=

# === Webhook Security ========================================================
WEBHOOK_SECRET=your-webhook-secret-here

# === Default Location & Language =============================================
DEFAULT_LAT=28.61
DEFAULT_LON=77.21
DEFAULT_WHATSAPP_LANG=hi
DEFAULT_LANG=en

# === Media Directory =========================================================
MEDIA_DIR=/tmp/weathergpt_media

# === Alert Generator (Layer 3) =================================================
ALERT_POLL_INTERVAL_SECONDS=900
ALERT_LANGUAGES=english,hindi
ALERT_POLL_LAT=28.61
ALERT_POLL_LON=77.21
ALERT_POLL_RADIUS_KM=2000
ALERT_POLL_DAYS=14
ALERT_MAX_DRAFTS_PER_CYCLE=20

# === Alert Dispatcher (Layer 4) =================================================
MAX_DISPATCH_CONCURRENCY=20
